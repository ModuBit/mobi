{
  "name": "@mobi/daemon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "generate:embedded-web-assets": "bun run scripts/generate-embedded-web-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:bun && bun run test:vitest",
    "test:bun": "bun test --parallel tests/hub/",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@mobi/node-core": "workspace:*",
    "@mobi/shared": "workspace:*",
    "@socket.io/bun-engine": "^0.1.2",
    "cookie": "^2.0.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "ps-list": "^9.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.2",
    "vitest": "^5.0.2"
  },
  "sideEffects": false,
  "description": "Mobi 单机 daemon（原 hub + runner）"
}
