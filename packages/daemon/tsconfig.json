{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": [
            "es2020",
            "es2022"
        ],
        "noEmit": true,
        "types": [
            "node",
            "bun-types"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "tests/**/*.ts"
    ]
}
