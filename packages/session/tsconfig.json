{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react",
        "types": [
            "node",
            "bun-types"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}
