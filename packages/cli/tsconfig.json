{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react",
        "rootDir": "../..",
        "experimentalDecorators": true,
        "outDir": "dist",
        "noEmit": true,
        "types": [
            "node",
            "bun-types"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "#embedded-assets": [
                "./src/runtime/embeddedAssets"
            ]
        }
    },
    "include": [
        "../daemon/src/**/*.d.ts",
        "../daemon/src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tools/**/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
