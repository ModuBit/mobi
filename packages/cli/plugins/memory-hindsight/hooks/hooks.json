{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/dist/claude-sessionstart-hook.js"
                        ],
                        "timeout": 30
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.js"
                        ],
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/dist/claude-stop-hook.js"
                        ],
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}