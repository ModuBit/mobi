{
    "name": "@mobi/cli",
    "version": "0.1.0",
    "description": "Mobi CLI - Claude Code On the Go",
    "type": "module",
    "bin": {
        "mobi": "bin/mobi.cjs"
    },
    "files": [
        "bin/mobi.cjs"
    ],
    "scripts": {
        "dev": "bun src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build:exe": "bun run scripts/build-executable.ts",
        "postinstall": "bun run scripts/unpack-tools.ts",
        "tools:unpack": "bun run scripts/unpack-tools.ts"
    },
    "bugs": "https://github.com/modu/mobi/issues",
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.144",
        "@anthropic-ai/sandbox-runtime": "^0.0.52",
        "@anthropic-ai/sdk": "^0.96.0",
        "@mobi/shared": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "axios": "^1.16.1",
        "chalk": "^5.6.2",
        "cross-spawn": "^7.0.6",
        "fastify": "^5.8.5",
        "fastify-type-provider-zod": "6.1.0",
        "ink": "^7.0.3",
        "ps-list": "^9.0.0",
        "react": "^19.2.6",
        "socket.io-client": "^4.8.3",
        "tar": "^7.5.15",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^25.9.0",
        "@types/react": "^19.2.14",
        "bun-types": "^1.3.14",
        "typescript": "^6.0.3",
        "vitest": "^4.1.6"
    }
}
