{
    "name": "@mobi/cli",
    "version": "0.1.0",
    "description": "Mobi CLI - Claude Code On the Go",
    "type": "module",
    "scripts": {
        "dev": "bun src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build:exe": "bun run scripts/build-executable.ts --with-web-assets",
        "build:exe:raw": "bun run scripts/build-executable.ts",
        "postinstall": "bun run scripts/unpack-tools.ts",
        "tools:unpack": "bun run scripts/unpack-tools.ts"
    },
    "imports": {
        "#embedded-assets": {
            "bun": "./src/runtime/embeddedAssets.bun.ts",
            "default": "./src/runtime/embeddedAssets.stub.ts"
        }
    },
    "bugs": "https://github.com/modu/mobi/issues",
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.237",
        "@anthropic-ai/sandbox-runtime": "^0.0.73",
        "@anthropic-ai/sdk": "^0.120.0",
        "@mobi/shared": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@tavily/core": "^0.7.7",
        "axios": "^1.19.0",
        "chalk": "^6.0.0",
        "cross-spawn": "^7.0.6",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "7.0.0",
        "ink": "^7.1.1",
        "ps-list": "^9.0.0",
        "react": "^19.2.8",
        "react-devtools-core": "file:./stubs/react-devtools-core",
        "socket.io-client": "^4.8.3",
        "tar": "^7.5.22",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "bun-types": "^1.3.14",
        "vitest": "^4.1.11"
    }
}
