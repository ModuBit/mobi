{
  "name": "@mobi/cli",
  "version": "0.1.0",
  "description": "Mobi CLI - Claude Code On the Go",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:exe": "bun run scripts/build-executable.ts --with-web-assets",
    "build:exe:raw": "bun run scripts/build-executable.ts",
    "postinstall": "bun run scripts/unpack-tools.ts",
    "tools:unpack": "bun run scripts/unpack-tools.ts"
  },
  "imports": {
    "#embedded-assets": {
      "bun": "./src/runtime/embeddedAssets.bun.ts",
      "default": "./src/runtime/embeddedAssets.stub.ts"
    }
  },
  "bugs": "https://github.com/modu/mobi/issues",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@anthropic-ai/sandbox-runtime": "^0.0.76",
    "@anthropic-ai/sdk": "^0.125.0",
    "@mobi/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tavily/core": "^0.7.10",
    "axios": "^1.20.0",
    "chalk": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "7.0.0",
    "ink": "^7.1.1",
    "ps-list": "^9.0.0",
    "react": "^19.3.0",
    "react-devtools-core": "file:./stubs/react-devtools-core",
    "socket.io-client": "^4.8.3",
    "tar": "^7.5.22",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.2",
    "vitest": "^5.0.0"
  }
}
