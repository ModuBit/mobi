        "qrcode": "^1.5.4",
        "socket.io": "^4.8.3",
        "web-push": "^3.6.7",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/node": ">=25",
        "@types/qrcode": "^1.5.6",
        "@types/web-push": "^3.6.4",
        "bun-types": "^1.3.5",
        "typescript": "^5"
    }
}
