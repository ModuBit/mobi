{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [
        ".scratch/**",
        ".mobi/**",
        "scripts/**",
        "packages/*/scripts/**",
        "perf/**"
    ],
    "ignoreBinaries": [
        "uvx",
        "loginctl"
    ],
    "rules": {
        "files": "error",
        "dependencies": "error",
        "unlisted": "error",
        "binaries": "warn",
        "unresolved": "error",
        "exports": "off",
        "types": "off",
        "nsExports": "off",
        "nsTypes": "off",
        "duplicates": "off",
        "enumMembers": "off",
        "optionalPeerDependencies": "off",
        "catalog": "off"
    },
    "workspaces": {
        ".": {},
        "packages/cli": {
            "entry": [
                "src/bootstrap.ts"
            ]
        },
        "packages/web": {}
    }
}
