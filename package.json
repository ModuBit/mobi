{
    "name": "mobi",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --parallel dev:hub dev:web",
        "build": "bun run build:hub && bun run build:web",
        "build:hub": "cd packages/hub && bun run build",
        "build:web": "cd packages/web && bun run build",
        "build:exe": "bun run build:web && (cd packages/hub && bun run generate:embedded-web-assets) && (cd packages/cli && bun run build:exe)",
        "build:exe:all": "bun run build:web && (cd packages/hub && bun run generate:embedded-web-assets) && (cd packages/cli && bun run build:exe --all)",
        "dev:hub": "cd packages/hub && bun run dev",
        "dev:web": "cd packages/web && bun run dev",
        "dev:https": "MOBI_DEV_HTTPS=1 bun run dev",
        "typecheck": "bun run typecheck:shared && bun run typecheck:hub && bun run typecheck:cli && bun run typecheck:web",
        "typecheck:shared": "cd packages/shared && bun run typecheck",
        "typecheck:hub": "cd packages/hub && bun run typecheck",
        "typecheck:cli": "cd packages/cli && bun run typecheck",
        "typecheck:web": "cd packages/web && bun run typecheck",
        "test": "bun run test:shared && bun run test:hub && bun run test:cli && bun run test:web",
        "test:shared": "cd packages/shared && bun run test",
        "test:hub": "cd packages/hub && bun run test",
        "test:cli": "cd packages/cli && bun run test",
        "test:web": "cd packages/web && bun run test",
        "lint": "eslint packages/shared/src packages/hub/src packages/cli/src packages/web/src",
        "lint:deps": "depcruise packages/shared/src packages/hub/src packages/cli/src packages/web/src",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "dependency-cruiser": "^18.2.0",
        "eslint": "^10.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0"
    },
    "dependencies": {
        "@tiptap/extension-task-item": "^3.31.2",
        "@tiptap/extension-task-list": "^3.31.2"
    },
    "lint-staged": {
        "packages/*/src/**/*.{ts,tsx}": "eslint --fix"
    },
    "patchedDependencies": {
        "@socket.io/bun-engine@0.1.1": "patches/@socket.io%2Fbun-engine@0.1.1.patch"
    }
}
