{
    "name": "mobi",
    "private": true,
    "workspaces": ["shared", "hub", "cli", "web"],
    "scripts": {
        "dev": "concurrently \"bun run dev:hub\" \"bun run dev:web\" --kill-others-on-fail",
        "build": "bun run build:hub && bun run build:web",
        "build:hub": "cd hub && bun run build",
        "build:web": "cd web && bun run build",
        "dev:hub": "cd hub && bun run dev",
        "dev:web": "cd web && bun run dev",
        "typecheck": "bun run typecheck:shared && bun run typecheck:hub && bun run typecheck:cli && bun run typecheck:web",
        "typecheck:shared": "cd shared && bun run typecheck",
        "typecheck:hub": "cd hub && bun run typecheck",
        "typecheck:cli": "cd cli && bun run typecheck",
        "typecheck:web": "cd web && bun run typecheck",
        "test": "bun run test:hub && bun run test:web",
        "test:hub": "cd hub && bun run test",
        "test:web": "cd web && bun run test",
        "lint": "eslint shared/src hub/src cli/src web/src",
        "lint:deps": "depcruise shared/src hub/src cli/src web/src"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^9.2.1",
        "dependency-cruiser": "^17.3.10",
        "eslint": "^10.2.0",
        "typescript-eslint": "^8.58.2"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0"
    }
}
