{
    "name": "mobi",
    "private": true,
    "workspaces": ["packages/*"],
    "scripts": {
        "dev": "concurrently \"bun run dev:hub\" \"bun run dev:web\" --kill-others-on-fail",
        "build": "bun run build:hub && bun run build:web",
        "build:hub": "cd packages/hub && bun run build",
        "build:web": "cd packages/web && bun run build",
        "dev:hub": "cd packages/hub && bun run dev",
        "dev:web": "cd packages/web && bun run dev",
        "typecheck": "bun run typecheck:shared && bun run typecheck:hub && bun run typecheck:cli && bun run typecheck:web",
        "typecheck:shared": "cd packages/shared && bun run typecheck",
        "typecheck:hub": "cd packages/hub && bun run typecheck",
        "typecheck:cli": "cd packages/cli && bun run typecheck",
        "typecheck:web": "cd packages/web && bun run typecheck",
        "test": "bun run test:hub && bun run test:cli && bun run test:web",
        "test:hub": "cd packages/hub && bun run test",
        "test:cli": "cd packages/cli && bun run test",
        "test:web": "cd packages/web && bun run test",
        "lint": "eslint packages/shared/src packages/hub/src packages/cli/src packages/web/src",
        "lint:deps": "depcruise packages/shared/src packages/hub/src packages/cli/src packages/web/src"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^9.2.1",
        "dependency-cruiser": "^17.4.0",
        "eslint": "^10.4.0",
        "typescript-eslint": "^8.59.4"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0"
    }
}
