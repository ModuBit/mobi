# hindsight 自部署配置 —— 启动前必填：LLM API key、embeddings API key（云端方案）、两个访问密钥
# 改完 .env 后用 ./hindsight.sh restart 生效

# ── LLM 提供商（三选一，取消注释对应段）──

# DeepSeek（内置 provider，默认模型 deepseek-v4-flash）
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_API_KEY=sk-你的DeepSeek-key
HINDSIGHT_API_LLM_MODEL=deepseek-v4-flash

# GLM（内置 zai provider，默认模型 glm-4.5-flash）
#HINDSIGHT_API_LLM_PROVIDER=zai
#HINDSIGHT_API_LLM_API_KEY=你的GLM-key
#HINDSIGHT_API_LLM_MODEL=glm-4.5-flash

# Qwen（DashScope OpenAI 兼容端点）
#HINDSIGHT_API_LLM_PROVIDER=openai
#HINDSIGHT_API_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#HINDSIGHT_API_LLM_API_KEY=sk-你的DashScope-key
#HINDSIGHT_API_LLM_MODEL=qwen-flash

# ── embeddings（云端 / 本地 二选一，切换时注释另一组）──
# ⚠️ embedding 维度启动时锁 schema：有数据后换模型/provider 不能直接改——
# 需 document-transfer 导出旧 bank → 清空数据目录 → 新配置重启 → 导入（自动按新模型重嵌入，记忆不丢）
# 首启前（还没数据时）随便改，零成本

# 云端（默认）：DashScope text-embedding-v4，中文效果最好，与 LLM 共用同一把 DashScope key
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=sk-你的DashScope-key
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-v4
# DashScope embeddings 批量上限 10，超了会被限流
HINDSIGHT_API_EMBEDDINGS_OPENAI_BATCH_SIZE=10

# 本地：full 镜像自带，离线可用；默认模型是纯英文的，中文记忆必须用多语言版
# ⚠️ 从云端切回本地同样要走上面的导出/导入流程
#HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
#HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── reranker（本地 / 云端 二选一；不锁 schema，可随时切换）──

# 本地（默认）：读路径无网络依赖，多语言版
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# 云端：qwen3-rerank，同一把 DashScope key，中文排序更准
#HINDSIGHT_API_RERANKER_PROVIDER=alibaba
#HINDSIGHT_API_RERANKER_ALIBABA_API_KEY=sk-你的DashScope-key

# ── API 鉴权（mobi 记忆设置里填同一个 key）──
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=改成随机长串

# ── Control Plane UI 访问密钥（登录 9999 控制台用）──
HINDSIGHT_CP_ACCESS_KEY=改成随机长串
HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888
# 控制台背后调 API 用，必须与上面的 HINDSIGHT_API_TENANT_API_KEY 同值，
# 否则登录后页面全部报 invalid api key
HINDSIGHT_CP_DATAPLANE_API_KEY=改成随机长串（与 HINDSIGHT_API_TENANT_API_KEY 相同）

# ── 提取产物语言（可选）──
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Chinese
