# E2E 测试环境
MOBI_HOME=~/.mobi-e2e
MOBI_LISTEN_PORT=2224
MOBI_WEB_PORT=5175
MOBI_API_URL=http://localhost:2224
CORS_ORIGINS=http://localhost:2224,http://localhost:5175
CLI_API_TOKEN=e2e-test-token-mobi
