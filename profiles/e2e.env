# E2E 测试环境
MOBI_HOME=~/.mobi-e2e
MOBI_LISTEN_PORT=2224
MOBI_WEB_PORT=5175
MOBI_PROXY_PORT=8789
MOBI_API_URL=http://localhost:2224
CORS_ORIGINS=http://localhost:2224,http://localhost:5175
CLI_API_TOKEN=e2e-test-token-mobi
# 双密钥：E2E 环境 webApiToken 与 cliApiToken 同值（固定可重复；反向隔离由单测 cli-auth.test.ts 覆盖）
WEB_API_TOKEN=e2e-test-token-mobi
# 验证 agent teams（现象 3 修复）
MOBI_AGENT_TEAMS=1
# 远程桌面：真实场景测试直连本机屏幕共享（5900）；fake 冒烟用 15900（手动起 fake-rfb-server）
MOBI_DESKTOP_VNC_PORT=5900
